# Server Configuration
SERVER_PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/tripwiser?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_access_token_secret_key_here
JWT_REFRESH_SECRET=your_refresh_token_secret_key_here

# Google Gemini AI API
GEMINI_API_KEY=your_gemini_api_key_here

# Weather & Maps APIs
OPENWEATHER_KEY=your_openweather_api_key_here
GEOAPIFY_KEY=your_geoapify_api_key_here
LOCATIONIQ_KEY=your_locationiq_api_key_here

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email / SMTP Configuration
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
